@model QrAracIletisim.Models.ViewModels.StickerDetailsViewModel
@{
    ViewData["Title"] = "Etiket Geçmişi";
}

<a asp-action="Index" class="btn btn-link px-0 mb-2"><i class="bi bi-arrow-left"></i> Etiketlerim</a>
<h1>@Model.Vehicle</h1>
<p class="text-muted">
    <span class="badge @Model.Status.BadgeClass()">@Model.Status.Label()</span>
    Saatte en fazla @Model.HourlyMessageLimit bildirim alırsınız.
</p>

<h2 class="h5 mt-4">Gelen bildirimler</h2>
@if (Model.Contacts.Count == 0)
{
    <div class="alert alert-info">Bu etiketten henüz bildirim gelmedi.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Tür</th>
                <th>İçerik</th>
                <th>Sonuç</th>
                <th>Ziyaretçi</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Contacts)
            {
                <tr>
                    <td class="text-nowrap">@c.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@c.Type.Label()</td>
                    <td>@c.Text</td>
                    <td>@c.Result.Label()</td>
                    <td><code>@c.Visitor</code></td>
                    <td class="text-end">
                        @if (!c.IsBlocked)
                        {
                            <form asp-action="Block" asp-route-id="@c.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-slash-circle"></i> Engelle</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">Engellenen ziyaretçiler</h2>
@if (Model.Blocked.Count == 0)
{
    <div class="alert alert-info">Engellediğiniz bir ziyaretçi yok.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Ziyaretçi</th>
                <th>Engellenme tarihi</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Blocked)
            {
                <tr>
                    <td><code>@b.Visitor</code></td>
                    <td class="text-nowrap">@b.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end">
                        <form asp-action="Unblock" asp-route-id="@b.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Engeli Kaldır</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
