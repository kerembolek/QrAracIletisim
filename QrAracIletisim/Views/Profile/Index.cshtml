@model QrAracIletisim.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Hesabım";
}

<h1><i class="bi bi-person-gear"></i> Hesabım</h1>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Bildirim kanalı</h2>
                <p class="text-muted">Etiketinizden gelen mesajlar bu kanaldan ulaşır.</p>
                <form asp-action="SetChannel" method="post">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="notifyViaWhatsApp" id="channelSms" value="false" checked="@(!Model.NotifyViaWhatsApp)" />
                        <label class="form-check-label" for="channelSms">SMS</label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" name="notifyViaWhatsApp" id="channelWhatsApp" value="true" checked="@Model.NotifyViaWhatsApp" />
                        <label class="form-check-label" for="channelWhatsApp">WhatsApp</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Telefon numarası</h2>
                <p class="text-muted">Kayıtlı numaranız: <strong>@Model.MaskedPhone</strong>. Giriş yaparken de bu numarayı kullanırsınız.</p>
                <form asp-action="RequestPhoneChange" method="post">
                    <div class="mb-3">
                        <label for="newPhone" class="form-label">Yeni numara</label>
                        <input id="newPhone" name="newPhone" class="form-control" type="tel" placeholder="05xx xxx xx xx" />
                    </div>
                    <button type="submit" class="btn btn-primary">Doğrulama Kodu Gönder</button>
                </form>
            </div>
        </div>
    </div>
</div>
