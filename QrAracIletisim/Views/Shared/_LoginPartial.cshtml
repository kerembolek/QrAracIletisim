@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @* Owners' user name is their phone number, so it is shown masked *@
            <i class="bi bi-person-circle"></i>
            @(User.Identity!.Name!.Contains('@') ? User.Identity.Name : QrAracIletisim.Services.PhoneNumbers.Mask(User.Identity.Name))
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
    </li>
}
</ul>
