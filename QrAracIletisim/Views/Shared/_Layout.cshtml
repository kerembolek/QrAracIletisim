<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QR Araç İletişim</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QrAracIletisim.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // Highlights the menu entry of the current section
        var currentController = ViewContext.RouteData.Values["controller"] as string;
        string Active(string controller) =>
            string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? " active" : "";
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar mb-4">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-qr-code"></i> QR Araç İletişim
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link@(Active("Home"))" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Ana Sayfa</a>
                        </li>
                        @if (User.IsInRole(Roles.Admin))
                        {
                        <li class="nav-item">
                            <a class="nav-link@(Active("Dashboard"))" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Pano</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link@(Active("Stickers"))" asp-area="" asp-controller="Stickers" asp-action="Index"><i class="bi bi-qr-code"></i> Etiketler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link@(Active("Users"))" asp-area="" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Kullanıcılar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link@(Active("Outbox"))" asp-area="" asp-controller="Outbox" asp-action="Index"><i class="bi bi-envelope-paper"></i> Giden Kutusu</a>
                        </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success d-flex align-items-center gap-2">
                <i class="bi bi-check-circle"></i>
                <span>@success</span>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle"></i>
                <span>@error</span>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QR Araç İletişim - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
