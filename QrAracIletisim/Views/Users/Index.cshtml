@model List<QrAracIletisim.Models.ViewModels.UserRow>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<h1><i class="bi bi-people"></i> Kullanıcılar</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Henüz kullanıcı yok.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Telefon / e-posta</th>
                <th>Rol</th>
                <th>Etiket</th>
                <th>Kayıt tarihi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Name</td>
                    <td class="text-nowrap">@u.Login</td>
                    <td>@u.Role</td>
                    <td>@u.StickerCount</td>
                    <td class="text-nowrap">@u.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
