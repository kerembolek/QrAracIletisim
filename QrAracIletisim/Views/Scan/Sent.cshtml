@model ContactResult
@{
    ViewData["Title"] = "Sonuç";
    var maskedNumber = ViewData["MaskedNumber"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5 text-center">
        @if (Model == ContactResult.Delivered)
        {
            <div class="icon-box bg-success-subtle text-success mb-3"><i class="bi bi-check-lg"></i></div>
            @if (maskedNumber is not null)
            {
                <h1 class="h3">Gizli hat hazır</h1>
                <p class="text-muted">Aşağıdaki numarayı 10 dakika içinde arayın. Görüşme araç sahibine bağlanır, iki taraf da birbirinin numarasını görmez.</p>
                <a class="btn btn-success btn-lg" href="tel:@maskedNumber.Replace(" ", "")"><i class="bi bi-telephone me-2"></i>@maskedNumber</a>
            }
            else
            {
                <h1 class="h3">Mesajınız iletildi</h1>
                <p class="text-muted">Araç sahibine bildirim gönderildi. Teşekkür ederiz.</p>
            }
        }
        else if (Model == ContactResult.RateLimited)
        {
            <div class="icon-box bg-warning-subtle text-warning mb-3"><i class="bi bi-hourglass-split"></i></div>
            <h1 class="h3">Biraz bekleyin</h1>
            <p class="text-muted">Bu araç için kısa sürede çok fazla bildirim gönderildi. Lütfen daha sonra tekrar deneyin.</p>
        }
        else
        {
            @* Blocked visitors see the same text as any other refusal, so they cannot tell they were blocked *@
            <div class="icon-box bg-secondary-subtle text-secondary mb-3"><i class="bi bi-slash-circle"></i></div>
            <h1 class="h3">İletilemedi</h1>
            <p class="text-muted">Bildiriminiz şu anda iletilemiyor.</p>
        }
        <div class="mt-3">
            <a asp-action="Index" asp-route-token="@ViewData["Token"]" class="btn btn-link">Geri dön</a>
        </div>
    </div>
</div>
