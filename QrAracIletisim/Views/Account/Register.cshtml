@model QrAracIletisim.Models.ViewModels.RegisterPhoneViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-3"><i class="bi bi-person-plus"></i> Kayıt Ol</h1>
                <p class="text-muted">Telefonunuza tek kullanımlık bir SMS kodu göndereceğiz.</p>
                <form asp-action="Register" method="post">
                    <input type="hidden" asp-for="Claim" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" type="tel" autocomplete="tel" placeholder="05xx xxx xx xx" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Kod Gönder</button>
                </form>
            </div>
        </div>
    </div>
</div>
